# Copier ce fichier en .env (à côté de index.js) et l'adapter à l'établissement.
# Les variables d'environnement du système (ou du service) sont prioritaires.

# Annuaire Active Directory
AD_URL=ldap://serveur-ad.exemple.local
AD_BASE_DN=DC=exemple,DC=local
AD_DOMAINE_UPN=exemple.local

# Groupes AD (insensibles à la casse) : administrateurs (accès à la console) et élèves
AD_GROUPE_ADMIN=g_profs
AD_GROUPE_ELEVE=g_eleves

# Clé de signature des sessions : une longue chaîne aléatoire
# (par exemple : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=

# Fichier de la base SQLite
DB_PATH=./launcher.sqlite
